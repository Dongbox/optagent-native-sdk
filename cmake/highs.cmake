set(HIPO "${OPTAGENT_SDK_HIPO}" CACHE BOOL "" FORCE)
set(HIGHSINT64 OFF CACHE BOOL "SDK uses 32-bit HiGHS indices" FORCE)
set(BUILD_CXX ON CACHE BOOL "" FORCE)
set(BUILD_CXX_EXE OFF CACHE BOOL "" FORCE)
set(BUILD_TESTING OFF CACHE BOOL "" FORCE)
set(BUILD_EXAMPLES OFF CACHE BOOL "" FORCE)
set(ZLIB OFF CACHE BOOL "" FORCE)
set(BUILD_SHARED_EXTRAS_LIB OFF CACHE BOOL "" FORCE)
set(HIGHS_LIBRARY_NAME optagent_highs CACHE STRING "" FORCE)
if(OPTAGENT_SDK_HIPO AND NOT APPLE)
  if(WIN32)
    set(HIGHS_BUNDLED_BLAS_LIBRARY lib/openblas.lib CACHE STRING "" FORCE)
  else()
    set(HIGHS_BUNDLED_BLAS_LIBRARY lib/libopenblas.a CACHE STRING "" FORCE)
  endif()
  add_library(highs::bundled_blas STATIC IMPORTED)
  set_target_properties(highs::bundled_blas PROPERTIES
    IMPORTED_LOCATION "${OPTAGENT_OPENBLAS_ROOT}/${HIGHS_BUNDLED_BLAS_LIBRARY}"
    INTERFACE_INCLUDE_DIRECTORIES "${OPTAGENT_OPENBLAS_ROOT}/include/openblas")
  set(BUILD_OPENBLAS OFF CACHE BOOL "" FORCE)
  set(HIGHS_BLAS_CONFIGURED TRUE)
  set(HIGHS_BLAS_TARGET highs::bundled_blas)
  set(HIGHS_BLAS_INCLUDE_DIRS "${OPTAGENT_OPENBLAS_ROOT}/include/openblas")
  set(HIGHS_BLAS_COMPILE_DEFINITION HIPO_USES_OPENBLAS)
  set(HIGHS_BLAS_VENDOR OpenBLAS)
  set(HIGHS_BLAS_VERSION 0.3.30)
  set(HIGHS_BLAS_LICENSE BSD-3-Clause)
endif()
add_subdirectory("${SDK_HIGHS_SOURCE_DIR}" highs)
include("${CMAKE_CURRENT_LIST_DIR}/elf-symbols.cmake")
sdk_elf_symbols(highs OPTAGENT_NATIVE_1)

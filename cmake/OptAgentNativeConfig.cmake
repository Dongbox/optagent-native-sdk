include_guard(GLOBAL)
if(NOT CMAKE_CXX_STANDARD STREQUAL "20")
  message(FATAL_ERROR "Set CMAKE_CXX_STANDARD=20 before importing the native SDK")
endif()
get_filename_component(OPTAGENT_NATIVE_PREFIX "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
set(_sdk_manifest "${OPTAGENT_NATIVE_PREFIX}/manifest.json")
if(NOT EXISTS "${_sdk_manifest}")
  message(FATAL_ERROR "Native SDK manifest is missing: ${_sdk_manifest}")
endif()
file(READ "${_sdk_manifest}" _sdk_json)
string(JSON OPTAGENT_NATIVE_VERSION GET "${_sdk_json}" version)
string(JSON OPTAGENT_NATIVE_LINKAGE GET "${_sdk_json}" linkage)
string(JSON _sdk_configuration GET "${_sdk_json}" configuration)
string(JSON _sdk_sanitizer GET "${_sdk_json}" sanitizer)
foreach(_field compiler_id compiler_version system processor)
  string(JSON _sdk_${_field} GET "${_sdk_json}" modules common toolchain ${_field})
endforeach()
if(NOT CMAKE_CXX_COMPILER_ID STREQUAL _sdk_compiler_id OR
   NOT CMAKE_CXX_COMPILER_VERSION VERSION_EQUAL _sdk_compiler_version OR
   NOT CMAKE_SYSTEM_NAME STREQUAL _sdk_system)
  message(FATAL_ERROR
    "Native SDK toolchain differs from this consumer. "
    "SDK: ${_sdk_system}/${_sdk_compiler_id}/${_sdk_compiler_version}; "
    "consumer: ${CMAKE_SYSTEM_NAME}/${CMAKE_CXX_COMPILER_ID}/${CMAKE_CXX_COMPILER_VERSION}")
endif()
string(TOLOWER "${CMAKE_SYSTEM_PROCESSOR}" _consumer_arch)
string(TOLOWER "${_sdk_processor}" _sdk_arch)
foreach(_variable _consumer_arch _sdk_arch)
  string(REGEX REPLACE "^(amd64|x64)$" "x86_64" ${_variable} "${${_variable}}")
  string(REGEX REPLACE "^aarch64$" "arm64" ${_variable} "${${_variable}}")
endforeach()
if(NOT _consumer_arch STREQUAL _sdk_arch)
  message(FATAL_ERROR "Native SDK architecture differs: ${_sdk_arch} / ${_consumer_arch}")
endif()
if((_sdk_configuration STREQUAL "Debug" AND NOT CMAKE_BUILD_TYPE STREQUAL "Debug") OR
   (CMAKE_BUILD_TYPE STREQUAL "Debug" AND NOT _sdk_configuration STREQUAL "Debug"))
  message(FATAL_ERROR "Debug and release-ABI SDK profiles cannot be mixed")
endif()
set(_consumer_sanitizer "")
if(OPTAGENT_ENABLE_SANITIZERS)
  set(_consumer_sanitizer address)
elseif(OPTAGENT_ENABLE_TSAN)
  set(_consumer_sanitizer thread)
endif()
if(NOT _consumer_sanitizer STREQUAL _sdk_sanitizer)
  message(FATAL_ERROR "Native SDK sanitizer profile differs from this consumer")
endif()
if(APPLE)
  string(JSON _sdk_deployment ERROR_VARIABLE _deployment_error GET "${_sdk_json}" deployment_target)
  if(NOT _deployment_error AND _sdk_deployment)
    if(NOT CMAKE_OSX_DEPLOYMENT_TARGET)
      set(CMAKE_OSX_DEPLOYMENT_TARGET "${_sdk_deployment}" CACHE STRING "SDK deployment baseline" FORCE)
    elseif(CMAKE_OSX_DEPLOYMENT_TARGET VERSION_LESS _sdk_deployment)
      message(FATAL_ERROR "Consumer deployment target is older than the native SDK baseline")
    endif()
  endif()
endif()
if(NOT EXISTS "${OPTAGENT_NATIVE_PREFIX}/include/optagent_native/abi.h")
  message(FATAL_ERROR "Native SDK ABI contract header is missing")
endif()
try_compile(_sdk_abi_compatible
  SOURCE_FROM_CONTENT sdk_abi_check.cc "#include <optagent_native/abi.h>\nint main() {}\n"
  CMAKE_FLAGS "-DINCLUDE_DIRECTORIES=${OPTAGENT_NATIVE_PREFIX}/include"
    "-DCMAKE_CXX_STANDARD=20" "-DCMAKE_CXX_STANDARD_REQUIRED=ON"
  NO_CACHE OUTPUT_VARIABLE _sdk_abi_diagnostic)
if(NOT _sdk_abi_compatible)
  message(FATAL_ERROR "Native SDK C++ ABI profile differs:\n${_sdk_abi_diagnostic}")
endif()

include(CMakeFindDependencyMacro)
foreach(_dependency absl utf8_range protobuf OptAgentSupport highs OptAgentCpsat GTest)
  # find_package gives cached *_DIR values priority over PATHS/NO_DEFAULT_PATH.
  # Refresh them together when a consumer selects a different SDK installation.
  set(${_dependency}_DIR "${OPTAGENT_NATIVE_PREFIX}/lib/cmake/${_dependency}")
  set(${_dependency}_DIR "${${_dependency}_DIR}" CACHE PATH "Native SDK package" FORCE)
endforeach()
# Resolve the exact install tree before upstream package configs find their
# transitive dependencies. No ambient solver/runtime package may replace it.
find_dependency(absl CONFIG PATHS "${OPTAGENT_NATIVE_PREFIX}/lib/cmake/absl" NO_DEFAULT_PATH)
find_dependency(utf8_range CONFIG PATHS "${OPTAGENT_NATIVE_PREFIX}/lib/cmake/utf8_range" NO_DEFAULT_PATH)
find_dependency(protobuf 33.1.0 EXACT CONFIG PATHS "${OPTAGENT_NATIVE_PREFIX}/lib/cmake/protobuf" NO_DEFAULT_PATH)
find_dependency(OptAgentSupport CONFIG PATHS "${OPTAGENT_NATIVE_PREFIX}/lib/cmake/OptAgentSupport" NO_DEFAULT_PATH)
find_dependency(highs CONFIG PATHS "${OPTAGENT_NATIVE_PREFIX}/lib/cmake/highs" NO_DEFAULT_PATH)
find_dependency(OptAgentCpsat CONFIG PATHS "${OPTAGENT_NATIVE_PREFIX}/lib/cmake/OptAgentCpsat" NO_DEFAULT_PATH)
if("test-tools" IN_LIST OptAgentNative_FIND_COMPONENTS)
  find_dependency(GTest CONFIG PATHS "${OPTAGENT_NATIVE_PREFIX}/lib/cmake/GTest" NO_DEFAULT_PATH)
  set(OptAgentNative_test-tools_FOUND TRUE)
endif()
get_property(_sdk_imported_targets DIRECTORY PROPERTY IMPORTED_TARGETS)
foreach(_target IN LISTS _sdk_imported_targets)
  if(NOT _target MATCHES "^(absl::|protobuf::|utf8_range::|OptAgentSupport::|highs::|OptAgentCpsat::|GTest::)")
    continue()
  endif()
  get_target_property(_configurations ${_target} IMPORTED_CONFIGURATIONS)
  set(_properties IMPORTED_LOCATION IMPORTED_IMPLIB)
  foreach(_configuration IN LISTS _configurations)
    list(APPEND _properties "IMPORTED_LOCATION_${_configuration}" "IMPORTED_IMPLIB_${_configuration}")
  endforeach()
  foreach(_property IN LISTS _properties)
    get_target_property(_location ${_target} ${_property})
    if(_location)
      cmake_path(IS_PREFIX OPTAGENT_NATIVE_PREFIX "${_location}" NORMALIZE _inside)
      if(NOT _inside)
        message(FATAL_ERROR "A foreign runtime target was already loaded: ${_target}: ${_location}")
      endif()
    endif()
  endforeach()
endforeach()
if(NOT TARGET protobuf::protoc)
  add_executable(protobuf::protoc IMPORTED GLOBAL)
  if(WIN32)
    set(_protoc "${OPTAGENT_NATIVE_PREFIX}/bin/protoc.exe")
  else()
    set(_protoc "${OPTAGENT_NATIVE_PREFIX}/bin/protoc")
  endif()
  if(NOT EXISTS "${_protoc}")
    message(FATAL_ERROR "The matched host protoc is missing")
  endif()
  set_target_properties(protobuf::protoc PROPERTIES IMPORTED_LOCATION "${_protoc}")
endif()
if(NOT TARGET OptAgentNative::highs)
  add_library(OptAgentNative::highs ALIAS highs::highs)
  add_library(OptAgentNative::cpsat ALIAS OptAgentCpsat::cpsat)
endif()
if(NOT TARGET sodium)
  add_library(sodium ALIAS OptAgentSupport::sodium)
endif()
if(NOT TARGET highs)
  add_library(highs ALIAS highs::highs)
endif()
if(NOT TARGET optagent_cpsat)
  add_library(optagent_cpsat ALIAS OptAgentCpsat::cpsat)
endif()
string(JSON OPTAGENT_HIGHS_REVISION GET "${_sdk_json}" source_lock sources highs revision)
set(OPTAGENT_HIGHS_COMMIT "${OPTAGENT_HIGHS_REVISION}")
set(OPTAGENT_NATIVE_PROTO_INCLUDE_DIR "${OPTAGENT_NATIVE_PREFIX}/include")
set(OptAgentNative_FOUND TRUE)

set(ABSL_PROPAGATE_CXX_STD ON CACHE BOOL "" FORCE)
set(ABSL_ENABLE_INSTALL ON CACHE BOOL "" FORCE)
set(ABSL_BUILD_TESTING OFF CACHE BOOL "" FORCE)
set(ABSL_MSVC_STATIC_RUNTIME OFF CACHE BOOL "" FORCE)
add_subdirectory("${SDK_ABSEIL_SOURCE_DIR}" abseil)
set(protobuf_BUILD_TESTS OFF CACHE BOOL "" FORCE)
set(protobuf_BUILD_CONFORMANCE OFF CACHE BOOL "" FORCE)
set(protobuf_BUILD_EXAMPLES OFF CACHE BOOL "" FORCE)
set(protobuf_INSTALL ON CACHE BOOL "" FORCE)
set(protobuf_BUILD_PROTOC_BINARIES OFF CACHE BOOL "" FORCE)
set(protobuf_BUILD_LIBPROTOC OFF CACHE BOOL "" FORCE)
set(protobuf_BUILD_LIBUPB OFF CACHE BOOL "" FORCE)
set(protobuf_ABSL_PROVIDER package CACHE STRING "" FORCE)
set(protobuf_WITH_ZLIB OFF CACHE BOOL "" FORCE)
set(protobuf_MSVC_STATIC_RUNTIME OFF CACHE BOOL "" FORCE)
set(protobuf_BUILD_SHARED_LIBS "${BUILD_SHARED_LIBS}" CACHE BOOL "" FORCE)
# Replace upstream's anonymous ELF map with this SDK's named version node.
if(UNIX AND NOT APPLE AND BUILD_SHARED_LIBS)
  set(protobuf_HAVE_LD_VERSION_SCRIPT OFF CACHE BOOL "" FORCE)
endif()
add_subdirectory("${SDK_PROTOBUF_SOURCE_DIR}" protobuf)
include("${CMAKE_CURRENT_LIST_DIR}/elf-symbols.cmake")
foreach(_library libprotobuf libprotobuf-lite utf8_range utf8_validity)
  if(TARGET ${_library})
    sdk_elf_symbols(${_library} OPTAGENT_NATIVE_1)
  endif()
endforeach()
foreach(_library libprotobuf libprotobuf-lite utf8_range utf8_validity)
  if(TARGET ${_library})
    string(REPLACE "libprotobuf" "protobuf" _basename "${_library}")
    set_target_properties(${_library} PROPERTIES OUTPUT_NAME "optagent_${_basename}")
  endif()
endforeach()
# Runtime protobuf does not use command-line flags; upstream shares a broad
# dependency list with compiler/test targets. Keep flags registration private
# to the CP-SAT backend instead of propagating those Windows static archives.
foreach(_library libprotobuf libprotobuf-lite)
  foreach(_property LINK_LIBRARIES INTERFACE_LINK_LIBRARIES)
    get_target_property(_links ${_library} ${_property})
    if(_links)
      list(REMOVE_ITEM _links absl::flags)
      set_property(TARGET ${_library} PROPERTY ${_property} "${_links}")
    endif()
  endforeach()
endforeach()
foreach(target utf8_range utf8_validity)
  if(TARGET ${target} AND WIN32 AND BUILD_SHARED_LIBS)
    set_target_properties(${target} PROPERTIES WINDOWS_EXPORT_ALL_SYMBOLS ON)
  endif()
endforeach()
# Preserve upstream targets/import macros while giving the files private names.
function(sdk_name_abseil directory)
  get_property(targets DIRECTORY "${directory}" PROPERTY BUILDSYSTEM_TARGETS)
  get_property(children DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
  foreach(target IN LISTS targets)
    get_target_property(type ${target} TYPE)
    if(type MATCHES "^(STATIC|SHARED)_LIBRARY$")
      get_target_property(_basename ${target} OUTPUT_NAME)
      if(NOT _basename)
        set(_basename "${target}")
      endif()
      set_target_properties(${target} PROPERTIES OUTPUT_NAME "optagent_${_basename}")
    endif()
  endforeach()
  foreach(child IN LISTS children)
    sdk_name_abseil("${child}")
  endforeach()
endfunction()
sdk_name_abseil("${SDK_ABSEIL_SOURCE_DIR}")

